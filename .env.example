# Site URLs (optional)
# Leave empty for local dev — the app uses relative paths on one server.
# FRONTEND_URL=https://demo.yourdomain.com
# BACKEND_URL=https://api.yourdomain.com
#
# Single-server demo (app + API on same host):
# FRONTEND_URL=https://demo.yourdomain.com
# BACKEND_URL=
#
# Two-server demo (UI on one host, API on another):
# FRONTEND_URL=https://demo.yourdomain.com
# BACKEND_URL=https://api.yourdomain.com
# COOKIE_DOMAIN=.yourdomain.com

